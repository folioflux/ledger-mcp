{
  "name": "@folioflux/ledger-mcp",
  "version": "0.1.0",
  "description": "Local, read-only MCP server with deterministic finance tools over your own CSV bank exports.",
  "license": "MIT",
  "author": "FolioFlux",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/folioflux/ledger-mcp.git",
    "directory": "packages/ledger-mcp"
  },
  "homepage": "https://github.com/folioflux/ledger-mcp#readme",
  "bugs": "https://github.com/folioflux/ledger-mcp/issues",
  "keywords": [
    "mcp",
    "mcp-server",
    "model-context-protocol",
    "csv",
    "bank-statements",
    "ledger",
